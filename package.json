{
  "name": "webflow-starter",
  "version": "1.0.0",
  "description": "A starter template for Webflow projects with page-based routing",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node bin/build.js --dev",
    "build": "node bin/build.js",
    "lint": "eslint src --max-warnings=0 && prettier --check .",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "demo": "esbuild demo/mask-slider.demo.js --bundle --format=esm --outdir=demo/build --servedir=demo --serve=127.0.0.1:3001",
    "vercel:url": "node scripts/get-vercel-url.js",
    "verify:resources": "node scripts/verify-staging.mjs",
    "verify:project-hover": "node scripts/verify-project-hover.mjs"
  },
  "keywords": [
    "webflow",
    "starter",
    "esbuild"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@barba/core": "^2.10.3",
    "embla-carousel": "8.6.0",
    "gsap": "3.15.0",
    "lenis": "1.3.26"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.19.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.0.1",
    "globals": "^17.12.0",
    "prettier": "^3.1.0",
    "puppeteer-core": "^25.12.0"
  }
}
